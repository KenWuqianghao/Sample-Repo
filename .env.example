# =============================================================================
# Copy to .env and fill in values. Never commit .env.
#
# Local:    load_dotenv in webhook when you run make serve / uvicorn.
# Modal:    cloud uses Modal secrets (not this file). Sync after edits:
#            .venv/bin/python scripts/sync_modal_secrets.py
#
# Secret mapping (see scripts/sync_modal_secrets.py):
#   linq-secrets   -> LINQ_*, ALLOWED_SENDERS
#   github-token   -> GITHUB_TOKEN, GH_TOKEN, GITHUB_ACCESS_TOKEN, REPO_URL
#   model-secrets  -> everything else in this file (model, harness, extras)
#
# Do not put MODAL_TOKEN_ID / MODAL_TOKEN_SECRET here for sync; CLI uses ~/.modal.toml
# =============================================================================

# -----------------------------------------------------------------------------
# Linq Partner API + webhook (Modal secret: linq-secrets)
# -----------------------------------------------------------------------------

# Bearer token for https://api.linqapp.com/api/partner/v3
LINQ_TOKEN=

# Webhook HMAC signing secret (verifies X-Webhook-Signature + X-Webhook-Timestamp)
LINQ_SECRET=

# Your Linq number, E.164 (outbound From)
LINQ_FROM_NUMBER=

# Optional. Comma-separated E.164 allow-list for inbound senders. Empty = allow all.
# ALLOWED_SENDERS=+15551234567,+15559876543

# -----------------------------------------------------------------------------
# OpenAI-compatible LLM + harness defaults (Modal secret: model-secrets)
# Used inside Modal sandboxes when run_agent/exec the harness.
# -----------------------------------------------------------------------------

# Root URL with /v1 (e.g. https://api.openai.com/v1 or your proxy). Empty = placeholder behavior.
MODEL_BASE_URL=

# Preferred. Bearer for chat/completions (same secret also accepts OPENAI_API_KEY below).
MODEL_API_KEY=

# Alternative name some tools use; harness checks MODEL_API_KEY first.
# OPENAI_API_KEY=

# Model id passed to the API (e.g. gpt-4.1-mini)
HARNESS_MODEL=

# Module executed as: python -m $CODING_HARNESS_MODULE --prompt-file ...
CODING_HARNESS_MODULE=harness.run

# Max LLM/tool rounds per user message (default 32)
# HARNESS_MAX_AGENT_STEPS=32

# HTTP timeout for model requests in seconds (default 600)
# HARNESS_HTTP_TIMEOUT_SECONDS=600

# branch_pr: use per-sender git branch before tools (see docs/coding-harness.md)
# HARNESS_AUTONOMY=branch_pr

# Prefix for agent branches agent/<hash>; overridden per run by Modal as HARNESS_AGENT_BRANCH
# HARNESS_PR_BRANCH_PREFIX=agent/

# Set in sandbox by run_agent; optional override when running harness locally
# HARNESS_AGENT_BRANCH=

# Split long replies for iMessage bubbles (modal_app/agent.py + harness/format.py)
# HARNESS_MAX_REPLY_CHARS=800

# 1 = last stdout line is {"type":"final","result":...} (Modal sets this in sandbox)
# HARNESS_EMIT_FINAL_JSON_LINE=0

# Workspace root for harness state (default /app in sandbox)
# HARNESS_WORKDIR=/app

# GitHub PR base branch override (else repo default)
# HARNESS_REPO_BASE_BRANCH=main

# -----------------------------------------------------------------------------
# GitHub clone + tools (Modal secret: github-token)
# -----------------------------------------------------------------------------

# Fine-grained or classic PAT: repo read for clone, PR tools as needed
GITHUB_TOKEN=

# owner/repo (no https://, no .git) — used by modal_app/sandbox clone + harness tools
REPO_URL=

# Optional aliases read by harness/tools/github_api.py
# GH_TOKEN=
# GITHUB_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Modal CLI authentication (local machine only — NOT synced to Modal secrets)
# Use: modal token set --token-id ... --token-secret ...
# Or CI:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Optional: local FastAPI / tunnel helpers (synced to model-secrets if present)
# Your app code may ignore these; safe to omit on Modal.
# -----------------------------------------------------------------------------

# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8080
